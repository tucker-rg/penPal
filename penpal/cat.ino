const uint8_t DXL0 = 1;
const uint8_t DXL1 = 4;
const uint8_t DXL2 = 5;
const float DXL_PROTOCOL_VERSION = 2.0;
DynamixelShield dxl;

int counter = 0;
unsigned long controlTimer;
unsigned long lastTimer;
unsigned long INTERVAL = 80;

void setup() {
    dxl.begin(57600);
  // Set Port Protocol Version. This has to match with DYNAMIXEL protocol version.
  dxl.setPortProtocolVersion(DXL_PROTOCOL_VERSION);
  // Get DYNAMIXEL information
  dxl.ping(DXL0);
  dxl.ping(DXL1);
  dxl.ping(DXL2);

  // Turn off torque when configuring items in EEPROM area
  dxl.torqueOff(DXL0);
  dxl.torqueOff(DXL1);
  dxl.torqueOff(DXL2);
  dxl.setOperatingMode(DXL0, OP_POSITION);
  dxl.setOperatingMode(DXL1, OP_POSITION);
  dxl.setOperatingMode(DXL2, OP_POSITION);
  dxl.torqueOn(DXL0);
  dxl.torqueOn(DXL1);
  dxl.torqueOn(DXL2);
}

void loop() {
  controlTimer = millis();
  if (controlTimer - lastTimer > INTERVAL){
    lastTimer = controlTimer;
    counter++;
    if(counter>99){counter = 0;}
    dxl.setGoalPosition(1, cat[counter][0], UNIT_DEGREE);
    dxl.setGoalPosition(4, cat[counter][1], UNIT_DEGREE);
    dxl.setGoalPosition(5, cat[counter][2], UNIT_DEGREE);
  }

}
