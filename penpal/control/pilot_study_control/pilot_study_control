#include <Encoder.h>
#include <Bounce2.h>

#define NUM_BUTTONS 6

Encoder myEnc(6, 7);
Bounce modeSw = Bounce();

int modeSwState = LOW;

long encoderPosition;
long oldPosition;

const uint8_t BUTTON_PINS[NUM_BUTTONS] = {13,11,12,10,14,9};
Bounce * buttons = new Bounce[NUM_BUTTONS];

struct buttonState{
  byte state = 0;
  unsigned long start = 0;
  unsigned long stop = 0;
  unsigned long duration = 0;
};

buttonState BUTTON_STATES[NUM_BUTTONS];

void setup() {
  Serial.begin(115200);
  modeSw.attach(8, INPUT_PULLUP);
  for (int i = 0; i < NUM_BUTTONS; i++) {
    buttons[i].attach(BUTTON_PINS[i], INPUT_PULLUP);
    buttons[i].interval(5);   
  }
  encoderPosition = myEnc.read();
  oldPosition = encoderPosition;
}

void loop() {
  long newPosition = myEnc.read();
  if (newPosition - oldPosition == -4) {
    oldPosition = newPosition;
    encoderPosition++;
  }
  else if (newPosition - oldPosition == 4){
    oldPosition = newPosition;
    encoderPosition--;
  }
  checkButtons();
  Serial.print(modeSwState); Serial.print("\t");
  if (modeSwState == 0){
    for (int i = 0; i < NUM_BUTTONS; i++){
      // Serial.print(BUTTON_STATES[i].state); Serial.print("\t");
      Serial.print(BUTTON_STATES[i].duration); Serial.print("\t");
    }
  }
  else{
    Serial.print(encoderPosition); Serial.print("\t");
  }
  // Serial.print(BUTTON_STATES[0].state); Serial.print("\t");
  // Serial.print(BUTTON_STATES[0].start); Serial.print("\t");
  // Serial.print(BUTTON_STATES[0].stop); Serial.print("\t");
  // Serial.print(BUTTON_STATES[0].duration);
  Serial.println();
  
}

void checkButtons(){
  modeSw.update();
  modeSwState = modeSw.read();
  for (int i = 0; i < NUM_BUTTONS; i++)  {
    // Update the Bounce instance :
    buttons[i].update();
    if (buttons[i].fell()){
      BUTTON_STATES[i].state = 1;
      BUTTON_STATES[i].start = millis();
    } 
    else if(buttons[i].rose()){
      BUTTON_STATES[i].state = 0;
      BUTTON_STATES[i].stop = millis();
      BUTTON_STATES[i].duration = BUTTON_STATES[i].stop - BUTTON_STATES[i].start;
    }
  }
}
