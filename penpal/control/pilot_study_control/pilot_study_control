#include <Encoder.h>
#include <Bounce2.h>

#define NUM_BUTTONS 6

Encoder myEnc(6, 7);
Bounce modeSw = Bounce();
Bounce b1 = Bounce();
Bounce b2 = Bounce();
Bounce b3 = Bounce();
Bounce b4 = Bounce();
Bounce b5 = Bounce();
Bounce b6 = Bounce();

int modeSwState = LOW;
int b1State = LOW;
int b2State = LOW;
int b3State = LOW;
int b4State = LOW;
int b5State = LOW;
int b6State = LOW;

const uint8_t BUTTON_PINS[NUM_BUTTONS] = {13,11,12,10,14,9};
Bounce * buttons = new Bounce[NUM_BUTTONS];

struct buttonState{
  byte state = 0;
  long timestamp;
};

buttonState BUTTON_STATES[NUM_BUTTONS];

void setup() {
  Serial.begin(115200);
  modeSw.attach(8, INPUT_PULLUP);
  for (int i = 0; i < NUM_BUTTONS; i++) {
    buttons[i].attach(BUTTON_PINS[i], INPUT_PULLUP);
    buttons[i].interval(5);   
  }

}

long oldPosition  = -999;

void loop() {
  modeSw.update(); b1.update(); b2.update(); b3.update(); b4.update(); b5.update(); b6.update();
  long newPosition = myEnc.read();
  if (newPosition != oldPosition) {
    oldPosition = newPosition;
    // Serial.println(newPosition);
  }
  checkButtons();
  Serial.print(modeSwState); Serial.print("\t");
  if (modeSwState == 0){
    Serial.print(b1State); Serial.print("\t");
    Serial.print(b2State); Serial.print("\t");
    Serial.print(b3State); Serial.print("\t");
    Serial.print(b4State); Serial.print("\t");
    Serial.print(b5State); Serial.print("\t");
    Serial.print(b6State); Serial.print("\n");
  }
  else{
    Serial.println(newPosition);
  }
  
}

void checkButtons(){
  if (modeSw.changed()) {
    modeSwState = modeSw.read();
  }
  for (int i = 0; i < NUM_BUTTONS; i++)  {
    // Update the Bounce instance :
    buttons[i].update();
    if (buttons[i].changed()){
      BUTTON_STATES[i].state = buttons[i].read();
      BUTTON_STATES[i].timestamp = millis();
    }
  }
}
